#!/bin/bash
#SBATCH --job-name=template5937
#SBATCH --partition={{partition}}
#SBATCH --time={{time}}
#SBATCH --cpus-per-task={{cpus}}
#SBATCH --mem={{mem}}
#SBATCH --mail-user={{email}}
#SBATCH --mail-type=END,FAIL
#SBATCH --output=slurm-%j.out
set -euo pipefail
cd {{remote_dir}}
podman run --rm -v .:/work -w /work $(podman build -q .) make all CONFIG={{config}}


